    <!-- ═══ FOOTER ═══ -->
    <footer class="store-footer" style="background: <%= footerBgColor || '#0f172a' %>; color: <%= footerTextColor || '#94a3b8' %>;">
        <div class="footer-container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4><%= storeName %></h4>
                    <% if (footerText) { %>
                    <p><%= footerText %></p>
                    <% } else { %>
                    <p>Votre boutique en ligne de confiance.</p>
                    <% } %>
                </div>

                <% if (showQuickLinks) { %>
                <div class="footer-col">
                    <h4>Navigation</h4>
                    <ul>
                        <li><a href="/">Accueil</a></li>
                        <li><a href="/products">Produits</a></li>
                    </ul>
                </div>
                <% } %>

                <% if (showContact) { %>
                <div class="footer-col">
                    <h4>Contact</h4>
                    <% if (storePhone) { %><p><i class="fa fa-phone"></i> <a href="tel:<%= storePhone %>"><%= storePhone %></a></p><% } %>
                    <% if (storeEmail) { %><p><i class="fa fa-envelope"></i> <a href="mailto:<%= storeEmail %>"><%= storeEmail %></a></p><% } %>
                    <% if (storeAddress) { %><p><i class="fa fa-map-marker"></i> <%= storeAddress %></p><% } %>
                </div>
                <% } %>

                <% if (showSocial && (socialFacebook || socialInstagram || socialTiktok)) { %>
                <div class="footer-col">
                    <h4>Suivez-nous</h4>
                    <div class="social-links" style="justify-content: flex-start;">
                        <% if (socialFacebook) { %><a href="<%= socialFacebook %>" target="_blank" class="social-link facebook"><i class="fa fa-facebook"></i></a><% } %>
                        <% if (socialInstagram) { %><a href="<%= socialInstagram %>" target="_blank" class="social-link instagram"><i class="fa fa-instagram"></i></a><% } %>
                        <% if (socialTiktok) { %><a href="<%= socialTiktok %>" target="_blank" class="social-link tiktok"><svg class="tiktok-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor"><path d="M448 209.9a210.1 210.1 0 01-122.8-39.3v178.8A162.6 162.6 0 11185 188.3v89.9a74.6 74.6 0 1052.2 71.2V0h88a121 121 0 00122.8 121z"/></svg></a><% } %>
                    </div>
                </div>
                <% } %>
            </div>

            <div class="footer-bottom">
                <span>&copy; <%= new Date().getFullYear() %> <%= storeName %>. Tous droits réservés.</span>
                <span>Propulsé par <a href="https://storiom.com" style="color: inherit; text-decoration: underline;">Storiom</a></span>
            </div>
        </div>
    </footer>
</body>
</html>
